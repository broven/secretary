#!/bin/sh
# Stable entrypoint: scrub every caller-repo-controllable broker env var, then
# exec the built binary with a minimal, runtime-computed environment.
set -eu

caller_cwd=$(pwd -P)
caller_path=${PATH-'/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin'}
script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)

run_user=${USER:-$(id -un)}

# Command line for env -i: leading NAME=VALUE pairs, then the binary and args.
set -- "$script_dir/../bin/secretary-core" --cwd "$caller_cwd" "$@"

# The scrub keeps SENV_TARGET_PATH so the child command gets the caller's PATH
# back, and SSH_AUTH_SOCK for git-over-ssh in the spawned command.
set -- \
  SENV_TARGET_PATH="$caller_path" \
  SSH_AUTH_SOCK="${SSH_AUTH_SOCK-}" \
  "$@"

# Optional passthroughs, only when actually set in the caller environment:
# SECRETARY_* keeps env-based config working through the scrub, and
# NODE_EXTRA_CA_CERTS lets a deliberately trusted local proxy CA validate.
for var in NODE_EXTRA_CA_CERTS SECRETARY_CLIENT_ID SECRETARY_TOKEN SECRETARY_URL; do
  eval "var_is_set=\${$var+set}"
  if [ "${var_is_set-}" = "set" ]; then
    eval "var_value=\$$var"
    set -- "$var=$var_value" "$@"
  fi
done

exec /usr/bin/env -i \
  HOME="${HOME-}" \
  USER="$run_user" \
  LOGNAME="${LOGNAME:-$run_user}" \
  SHELL="${SHELL:-/bin/sh}" \
  PATH='/usr/bin:/bin:/usr/sbin:/sbin' \
  LANG="${LANG:-en_US.UTF-8}" \
  "$@"
