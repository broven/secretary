# Non-secret configuration for docker compose. Copy to .env and fill in.
# Secrets (BW_CLIENTID, BW_CLIENTSECRET, BW_PASSWORD, TELEGRAM_BOT_TOKEN)
# live as files under deploy/secrets/ — see README.md.

# Vault to talk to. Must be https — the bw CLI refuses plain-http servers.
# Default is the compose-internal vaultwarden service with TLS terminated in
# the container (start it with --profile vaultwarden; see "TLS for the
# bundled vaultwarden" in README.md). For Bitwarden cloud:
# VAULT_URL=https://vault.bitwarden.com
VAULT_URL=https://vaultwarden

# Email of the vault automation account.
BW_EMAIL=

# Telegram chat that receives approval cards (your chat id).
TELEGRAM_CHAT_ID=

# Comma-separated numeric Telegram user ids allowed to approve/reject.
TELEGRAM_ALLOWED_USER_IDS=

# Vaultwarden only: allow signups for initial account creation, then set false.
SIGNUPS_ALLOWED=true

# Optional tuning (defaults shown):
# How long a Request stays parked in total, across every approval card it sends.
# NOTE: this used to mean "one card's lifetime". If you carried a value like 300
# over from an older deployment, the same window now gets split into
# APPROVAL_CARDS cards and the Owner is pinged far more often than intended.
# APPROVAL_TIMEOUT_S=1500
# How many cards that window is split into; each replaces the one before it.
# APPROVAL_CARDS=5
# How long an Entry Form link stays usable.
# ENTRY_TTL_S=1800
# SYNC_MAX_AGE_S=60
